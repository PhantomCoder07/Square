#include <stdio.h>
float area (float a)
{
    return a*a;
}
float peri (float a)
{
    return 4*a;
}
int main()
{
    float a;
    printf("Enter square's side value: ");
    scanf("%f",&a);
    printf("The area of square: %.2f\n",area(a));
    printf("The perimeter of square: %.2f\n",peri(a));
    return 0;
}
