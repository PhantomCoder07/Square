#include <stdio.h>
int main()
{
    FILE *file1,*file2;
    float a,area,peri;
    char ch;
    file1 = fopen ("Square.txt","w");
    file2 = fopen ("Square.txt","r");
    if (file1==NULL)
        printf ("The file does not exist");
    else
    {
        printf("Enter square's side value: ");
        scanf("%f",&a);
        area=(a*a);
        peri=4*a;
        fprintf(file1,"The area of square: %.2f\nThe perimeter of square: %.2f\n",area,peri);
        fclose (file1);
    }
    if (file2==NULL)
        printf ("The file does not exist");
    else
    {
        while (!feof(file2))
        {
            ch=fgetc(file2);
            printf ("%c",ch);
        }
        fclose (file2);
    }
    return 0;
}
